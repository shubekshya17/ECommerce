<div class="row">
    <div class="col-md-9">
        <div class="card">
            <div class="card-body">
                <button class="btn btn-danger btnRemoveProducts btn-sm">Clear Cart</button>
                <button class="btn btn-success btnCheckout btn-sm">Checkout</button>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Product Item Id</th>
                            <th>Product Name</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="listDatas">
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" style="text-align:right;font-weight:500;">Grand Total:</td>
                            <td colspan="1" class="grandTotalVal" style="color:green;font-weight:500"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Customer Info</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="card">
                  <div class="card-body">
                      <div class="row">
                          <div class="col-md-4">
                              <label>FullName</label>
                          </div>
                            <div class="col-md-8">
                                <input type="text" class="form-control txtFullName"/>
                            </div>
                      </div>
                        <div class="row mt-2">
                            <div class="col-md-4">
                                <label>Email</label>
                            </div>
                            <div class="col-md-8">
                                <input type="text" class="form-control txtEmail" />
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-4">
                                <label>MobileNo</label>
                            </div>
                            <div class="col-md-8">
                                <input type="text" class="form-control txtMobileNo" />
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-4">
                                <label>Address</label>
                            </div>
                            <div class="col-md-8">
                                <input type="text" class="form-control txtAddress" />
                            </div>
                        </div>
                  </div>
              </div>
            </div>
            <div class="modal-footer">
               @*  <button type="button" class="btn btn-success btnKhalti" data-bs-dismiss="modal">Pay With Khalti</button> *@
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary modalSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/ecom.js?v=2"></script>
    <script>
        $(document).ready(function () {
            loadItems();
            grandTotalCal();
        })
        $(document).on('click','.btnKhalti',function(){
            var ok = confirm("Are you sure you want to make payment?");
            if (ok) {
                debugger;
                var payload = {
                    Amount : +$(".grandTotalVal").html(),
                    RedirectUrl : 'http://localhost:5014'
                }
                $.ajax({
                    method: 'post',
                    contentType: "application/json;charset=utf-8",
                    data:JSON.stringify(payload),
                    url: '@Url.Action("KhaltiPayment", "OnlinePayment")',
                    success: function (res) {
                        if (res.success) {
                            var khalti = JSON.parse(res.data);
                            window.location.href = khalti.payment_url
                        }
                        else {
                            alert(res.message);
                        }
                    },
                    error: function (res) {
                        debugger;
                    }
                })
            }
        })
    </script>
}