@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}

<div class="card">
    <div class="card-body p-3">
        <div class="row">
            <div id="container"></div>
        </div>
    </div>
</div>
<script src="https://code.highcharts.com/highcharts.js"></script>
@section Scripts {
    <script>
        $(document).ready(function () {
            loadChart();
        });
        function loadChart() {
            $.ajax({
                method: 'get',
                url: "@Url.Action("GetChartData", "Home")",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    var chartData = data.countInfo.map(function (x) {
                        var userGroup = data.nameInfo.find(z => z.productItemId === x.productItemId);
                        var grpName = userGroup ? userGroup.productItemName : 'Unknown Group';
                        return {
                            name: grpName,
                            y: x.totalCount
                        }
                    })
                    Highcharts.chart('container', {
                        chart: {
                            type: 'pie'
                        },
                        title: {
                            text: 'Orders'
                        },
                        series: [
                            {
                                name: 'Count',
                                colorByPoint: true,
                                data: chartData
                            }
                        ]
                    });
                },
                error: function (e) {
                    console.log(e)
                }

            })
        }
    </script>
}


