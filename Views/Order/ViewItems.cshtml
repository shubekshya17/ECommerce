@model IEnumerable<ECommerce.Models.ViewModels.OrderWithNameVM>
<div class="row">
    <div class="col-md-9">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Product Item Name</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>

                        <td>@x.ProductName</td>
                        <td>@x.Quantity</td>
                        <td>@x.UnitPrice</td>
                        <td>@x.TotalPrice</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>