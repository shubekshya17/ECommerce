@model ECommerce.Models.ViewModels.ItemListVM

@foreach (var x in Model.ProductItems)
{
    <div style="display: flex; flex-direction: row; gap: 10px; align-items: flex-start; margin-bottom: 30px; padding: 15px; border: 1px solid #ddd; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">

        <div style="flex: 2;">
            <dl class="row" style="margin: 0;">
                <dt class="col-sm-4">Product Name</dt>
                <dd class="col-sm-8">@x.ProductName</dd>

                <dt class="col-sm-4">Product Code</dt>
                <dd class="col-sm-8">@x.ProductCode</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@x.Description</dd>

                <dt class="col-sm-4">Unit Price</dt>
                <dd class="col-sm-8">Rs. @x.UnitPrice</dd>
            </dl>
        </div>

        <div style="flex: 1;">
            <img src="@x.Thumbnail" style="width: 70%; height:60%" ; border-radius: 8px;" alt="Product Image" />
        </div>
    </div>
}
