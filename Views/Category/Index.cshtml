@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model IEnumerable<ECommerce.Models.Category>
<link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css" />
<style>
    .bodybtn{
        font-size:12px;
        padding:8px 18px;
        font-weight:600;
        margin-bottom:0px;
    }
    td{
        font-size:14px;
        font-weight:600;
    }
    th{
        font-size:15px;
        font-weight:650;
    }
    .btn-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.3rem;
    }
</style>
  <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                <table id="dtTable" class="table-class-hover dtTable">
                     <thead>
                    <th>Name</th>
                    <th>Unit</th>
                    <th>Action</th>
                    </thead>
                    <tbody id="listData">
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <form>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Name</label>
                        <input type="text" class="form-control formName">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput2">Category Code</label>
                        <input type="text" class="form-control formUnit">
                    </div>
                    <div class="btn-container">
                       <input type="hidden" class="hdnId" />
                        <button type="button" class="btn btn-primary btn-sm btnSave bodybtn">Save</button>
                        <button type="button" class="btn btn-danger btn-sm btnCancel bodybtn">Cancel</button>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
@section scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            loadData();
            $('#dtTable').DataTable();
        })
        function reloadData() {
            window.location.reload();
        }
        function loadData() {
            var html = '';
            $.ajax({
                method: 'get',
                url: 'Category/GetAllData',
                contentType: "application/json;charset=utf-8",
                success: function (res) {
                    $("#listData").find("tr").remove();
                    $.each(res.data, function (key, item) {
                        html += "<tr>" +
                            "<td>" + item.categoryName + "</td>" +
                            "<td>" + item.categoryUnit + "</td>" +
                            "<td>" +
                            "<button type='button' data-key='" + item.id + "' class='btn btn-dark btn-sm btnEdit bodybtn'>Edit</button> " +
                            "<button type='button' data-key='" + item.id + "' class='btn btn-danger btn-sm btnDelete bodybtn'>Delete</button>" +
                            "</td>" +
                            "</tr>";
                    })
                    $("#listData").append(html)
                }
            })
        }
        $(document).on('click', '.btnSave', function () {
            var hdnId = $('.hdnId').val() || 0;
            var name = $('.formName').val();
            var code = $('.formUnit').val();
            if (name == '') {
                toastr.error("Please Enter Name");
            } else if (code == '') {
                toastr.error("Please Enter Code");
            } else {
                $.ajax({
                    method: 'get',
                    url: '@Url.Action("Save", "Category")?categoryName=' + name + '&categoryCode=' + code + '&id=' + hdnId,
                    contentType: "application/json;charset=utf-8",
                    success: function (res) {
                        toastr.success(res.message);
                        clearForm();
                        loadData();
                    }
                })
            }
        })
        $(document).on('click', '.btnCancel', function () {
            Swal.fire({
                title: "Are you sure want to reset?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Reset it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $('.formName').val('');
                    $('.formUnit').val('');
                }
            });
        })
        $(document).on('click', '.btnDelete', function () {
            var id = $(this).data('key');
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        method: 'get',
                        url: '@Url.Action("Delete", "Category")?id=' + id,
                        contentType: "application/json;charset=utf-8",
                        success: function (res) {
                            toastr.success(res.message);
                            loadData();
                        }
                    })
                }
            });
        })
        function clearForm() {
            $('.formName').val('');
            $('.formUnit').val('');
        }

        $(document).on('click', '.btnEdit', function () {
            var id = $(this).data('key');
            $.ajax({
                method: 'get',
                url: '@Url.Action("Edit", "Category")?id=' + id,
                contentType: "application/json;charset=utf-8",
                success: function (res) {
                    if (res.success) {
                        $('.formName').val(res.data.categoryName);
                        $('.formUnit').val(res.data.categoryUnit);
                        $('.hdnId').val(res.data.id);
                    }
                }
            })
        })
    </script>
}
