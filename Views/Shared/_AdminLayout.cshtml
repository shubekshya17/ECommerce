            crossorigin="anonymous"></script>
    <script>
        $(document).on('click', '#signOut', function () {
            swal({
                title: "Are you sure you want to log out?",
                text: "You will be logged out!",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                closeOnConfirm: false
            },
                function (isConfirm) {
                    if (isConfirm) {
                        $.ajax({
                            method: "POST",
                            url: '@Url.Action("SignOut", "Authenticate")',
                            success: function () {
                                window.location.href = '@Url.Action("Login", "Authenticate")';
                            },
                            error: function () {
                                toastr.error("Sign Out Failed")
                            }
                        })
                        window.location.href = '@Url.Action("Index", "Home")';
                    }
                    else {
                        swal("Cancelled", "You are not logged out.", "error");
                    }
                }
            )
            /*Swal.fire({
                title: 'Are you sure?',
                text: 'You will be logged out.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, log out',
                cancelButtonText: 'No, stay here'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Index", "Admin")';
                } else {
                    Swal.fire('Cancelled', 'You are not logged out.', 'error');
                }
            });*/
        })
    </script>
    <script>
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('.nav-link');
        navLinks.forEach(x => {
            if (x.getAttribute('href') === currentPath) {
                x.classList.add('active');
                const icon = x.querySelector('i');
                if (icon) {
                    icon.style.color = '#ffffff';
                }
            }
            else {
                x.classList.remove('active');
            }
        })
    </script>
    <script>
        /*Since our Array looks like this:pathSegments = ['', 'User', 'Index']; after splitting then: .filter(Boolean) is used to erase: ''/null value.So the pathSegments.length = 2*/
        const pathSegments = window.location.pathname.split('/').filter(Boolean)
        const pathSegment = pathSegments.length >= 1 ? pathSegments[pathSegments.length - 1] : "None"; /* Now this gives pathSegments[0] that has User*/
        const formattedSegment = pathSegment.charAt(0).toUpperCase() + pathSegment.slice(1); /* The Character at 0 is U which is turned into Uppercase and + is used to concat all letters after U*/
        document.getElementById('current-breadcrumb').textContent = formattedSegment;
        document.getElementById('current-page').textContent = formattedSegment;
    </script>
    @RenderSection("Scripts", required: false)
</body>
